# Copy this file to .env and fill in your own values. NEVER commit .env.
# NEVER paste a private key that holds real mainnet funds into a shared or
# AI-assisted environment — for Robinhood Chain mainnet deployment, prefer a
# hardware wallet flow or a dedicated deploy-only key with a small balance.

# Private key of the account that will deploy the contract (no 0x prefix issues either way).
DEPLOYER_PRIVATE_KEY=

# Optional: a dedicated RPC endpoint (Alchemy/QuickNode/etc). The public
# rpc.testnet.chain.robinhood.com / rpc.mainnet.chain.robinhood.com endpoints
# are rate-limited and fine for occasional use, but get your own key for
# anything beyond casual testing.
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
