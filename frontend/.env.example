# Copy to .env and fill in. Vite only exposes vars prefixed VITE_ to the
# frontend, and reads them at build time — restart `npm run dev` (or
# redeploy) after changing this.

# Public client ID from https://dashboard.privy.io (Settings -> your app).
# Not a secret — safe to expose in frontend code. See README's
# "Wallet connection (Privy)" section for the two-minute setup.
VITE_PRIVY_APP_ID=
